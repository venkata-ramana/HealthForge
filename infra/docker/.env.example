# HealthForge private/local deployment example environment file
#
# Copy this file to `infra/docker/.env` for local non-production use:
#   cp infra/docker/.env.example infra/docker/.env
#
# Do not commit real secrets, production hostnames, or customer identifiers.

# Public API listener on the host machine
HEALTHFORGE_API_PORT=8080

# Host port mapped to the internal PostgreSQL container port 5432
HEALTHFORGE_DB_PORT=5433

# Local/non-production bootstrap values only. Replace before any shared deployment.
HEALTHFORGE_POSTGRES_DB=healthforge
HEALTHFORGE_POSTGRES_USER=healthforge
HEALTHFORGE_POSTGRES_PASSWORD=change-me-local-only

# Platform API database connection
HEALTHFORGE_DB_URL=jdbc:postgresql://postgres:5432/healthforge
HEALTHFORGE_DB_USERNAME=healthforge
HEALTHFORGE_DB_PASSWORD=change-me-local-only

# Identity mode remains local_header for demo and local review flows until
# a stronger enterprise identity provider is installed.
HEALTHFORGE_AUTH_MODE=local_header
HEALTHFORGE_DEFAULT_ORGANIZATION_ID=local.default

# Local storage and workspace paths inside the container
HEALTHFORGE_ARTIFACT_DIRECTORY=/var/lib/healthforge/artifacts
HEALTHFORGE_WORKSPACE_ROOT=/workspace

# Keep external model usage disabled in private pilot environments unless a
# separate risk review explicitly enables it.
HEALTHFORGE_MODEL_ENABLED=false
HEALTHFORGE_MODEL_PROVIDER=disabled
